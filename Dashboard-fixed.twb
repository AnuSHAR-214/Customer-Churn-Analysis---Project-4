      </column>
      <column caption='Churned Customers' datatype='integer' name='[Calculation_1027521678491649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Churn] = &quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Churn Rate %' datatype='real' name='[Calculation_1027521678643202]' role='measure' type='quantitative'>
